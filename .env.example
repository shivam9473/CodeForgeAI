API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Required for full LLM agents (planner / hunter / tests / review).
GEMINI_API_KEY=

# Optional. Empty = in-process MemoryBroker (same job deps/retries/DLQ).
# With Docker: redis://127.0.0.1:6379
REDIS_URL=

# Optional. Empty = in-memory store (chunks/findings/runs/memory).
# With Docker: postgres://codeforge:codeforge@127.0.0.1:5432/codeforge
DATABASE_URL=

FIXTURE_ROOT=
